# Server-side only — copy to .env (mode 600), never commit
ELABFTW_API_URL=https://elab.example.com/api/v2
ELABFTW_API_KEY=
ELAB_VERIFY_SSL=true
ELAB_INTEGRATION_LIVE=false
ELAB_PUBLIC_URL=https://elab.example.com
SCANNER_CORS_ORIGIN=https://elab.example.com
SCANNER_DB_PATH=/app/data/ledger.db
SCANNER_SESSION_SECRET=
OIDC_ISSUER=https://auth.example.com/application/o/inventory-scanner/
OIDC_CLIENT_ID=inventory-scanner-bff
OIDC_CLIENT_SECRET=
LOG_LEVEL=warning

# Branding (Lato lockup: product + endorsement; chrome #2B2B2B; accent interactive only)
BRAND_PRODUCT_NAME=VialTrack
BRAND_ENDORSEMENT=by Elijá Friedrich-Ulrich
BRAND_ACCENT_HEX=#29ADB9
